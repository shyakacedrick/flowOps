# ─── Server ───────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
API_PREFIX=/api

# Frontend base URL — used to build links in transactional emails.
APP_URL=http://localhost:5173

# ─── Database ─────────────────────────────────────────────────────────────
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/flowOps?retryWrites=true&w=majority
MONGO_MAX_POOL_SIZE=10
MONGO_SERVER_SELECTION_TIMEOUT_MS=5000

# ─── Auth ─────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_this_with_a_long_random_string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
BCRYPT_SALT_ROUNDS=10
REFRESH_COOKIE_NAME=flowops_refresh

# ─── CORS (comma-separated list, or * for all) ────────────────────────────
CORS_ORIGINS=http://localhost:5173

# ─── Logging ──────────────────────────────────────────────────────────────
# trace | debug | info | warn | error | fatal | silent
LOG_LEVEL=info

# ─── Email ────────────────────────────────────────────────────────────────
# The mailer picks a provider in this order:
#   1. RESEND_API_KEY set   → Resend HTTPS API
#   2. SMTP_HOST set        → SMTP (Mailtrap / SendGrid / Postmark / Gmail / …)
#   3. neither              → console fallback (emails printed to terminal)
#
# MAIL_FROM must be a verified sender for whichever provider is active.

# Option A — Resend
RESEND_API_KEY=
MAIL_FROM=FlowOps <onboarding@resend.dev>

# Option B — SMTP (Mailtrap example below; copy creds from your inbox settings)
# SMTP_HOST=sandbox.smtp.mailtrap.io
# SMTP_PORT=587
# SMTP_SECURE=false        # true only for port 465 (TLS-on-connect)
# SMTP_USER=
# SMTP_PASS=

EMAIL_VERIFY_TTL_HOURS=24
PASSWORD_RESET_TTL_MINS=60
