VITE_API_URL=http://localhost:5000/api

# Production example (set this in Netlify → Site settings → Environment):
# VITE_API_URL=https://flowops-backend.onrender.com/api

# Set to 'true' on the showcase deploy to enable the top "Demo mode — data
# resets nightly" banner. Leave unset (or 'false') for local dev.
# VITE_DEMO_MODE=true

# ─── Observability (optional) ─────────────────────────────────────────────
# Leave VITE_SENTRY_DSN empty to disable. When set, uncaught render errors
# are forwarded with bearer tokens / SSE token query params scrubbed.
# VITE_SENTRY_DSN=
# VITE_SENTRY_RELEASE=

